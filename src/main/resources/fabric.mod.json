{
  "schemaVersion": 1,
  "id": "backtooltweak",
  "version": "${version}",
  "name": "Back Tool Tweak",
  "description": "Ajusta posicao (x, y, z), rotacao e escala de cada item desenhado nas costas/cintura pelo BackSlot.",
  "authors": ["voce"],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": ["net.backtooltweak.BackToolTweakClient"],
    "modmenu": ["net.backtooltweak.ModMenuIntegration"]
  },
  "mixins": ["backtooltweak.mixins.json"],
  "depends": {
    "java": ">=21",
    "minecraft": "~1.21.1",
    "fabricloader": ">=0.16.5",
    "fabric-api": "*",
    "cloth-config2": ">=15.0.130",
    "backslot": "*"
  },
  "suggests": { "modmenu": "*", "backslotaddon": "*" }
}
